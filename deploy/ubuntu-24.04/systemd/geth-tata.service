[Unit]
Description=TataService Blockchain Execution Client (Go-Ethereum)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tataservice
Group=tataservice
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

ExecStart=/usr/local/bin/geth \
  --datadir=/var/lib/tataservice/geth \
  --networkid=810161 \
  --syncmode=full \
  --gcmode=full \
  --cache=256 \
  --state.scheme=path \
  --http \
  --http.addr=127.0.0.1 \
  --http.port=8545 \
  --http.api=eth,net,web3 \
  --ws \
  --ws.addr=127.0.0.1 \
  --ws.port=8546 \
  --ws.api=eth,net,web3 \
  --authrpc.addr=127.0.0.1 \
  --authrpc.port=8551 \
  --authrpc.jwtsecret=/var/lib/tataservice/jwt/jwtsecret \
  --metrics \
  --metrics.addr=127.0.0.1 \
  --metrics.port=6060

StandardOutput=journal
StandardError=journal
SyslogIdentifier=geth-tata

[Install]
WantedBy=multi-user.target
