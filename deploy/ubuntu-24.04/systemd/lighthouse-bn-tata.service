[Unit]
Description=TataService Blockchain Consensus Client (Lighthouse Beacon Node)
After=network-online.target geth-tata.service
Requires=geth-tata.service

[Service]
Type=simple
User=tataservice
Group=tataservice
EnvironmentFile=/opt/tataservice/.env
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

ExecStart=/usr/local/bin/lighthouse bn \
  --datadir=/var/lib/tataservice/lighthouse-bn \
  --testnet-dir=/opt/tataservice/network/consensus \
  --execution-endpoint=http://127.0.0.1:8551 \
  --execution-jwt=/var/lib/tataservice/jwt/jwtsecret \
  --http \
  --http-address=127.0.0.1 \
  --http-port=5052 \
  --metrics \
  --metrics-address=127.0.0.1 \
  --metrics-port=5054 \
  --suggested-fee-recipient=${TATA_VALIDATOR_OPS_ADDR} \
  --subscribe-all-subnets \
  --validator-monitor-auto

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lighthouse-bn-tata

[Install]
WantedBy=multi-user.target
